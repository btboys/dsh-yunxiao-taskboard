{
  "name": "dsh-yunxiao-taskboard",
  "version": "1.2.0",
  "description": "DeepSeek Harness plugin: Aliyun Yunxiao requirements and defects kanban by status, with detail drawer, image preview, one-click session dispatch and native tools for status transitions, change-log comments and Codeup commit linking.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "yunxiao",
    "aliyun",
    "kanban",
    "workitem"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btboys/dsh-yunxiao-taskboard.git"
  },
  "homepage": "https://github.com/btboys/dsh-yunxiao-taskboard#readme",
  "bugs": {
    "url": "https://github.com/btboys/dsh-yunxiao-taskboard/issues"
  },
  "icon": "./icon.svg",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "server",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
